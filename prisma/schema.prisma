// ============================================================
// CRM/SFA System - Prisma Schema (Phase 1)
// DB: Azure SQL (sqlserver) / Schema: CRMSFASystem
// ============================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
  schemas  = ["CRMSFASystem"]
}

// ============================================================
// Employee（社員）
// ============================================================
model Employee {
  id         String  @id @default(uuid())
  name       String
  department String?
  position   String?
  phone      String?
  email      String  @unique
  isActive   Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  deals             Deal[]            @relation("DealEmployee")
  assignedTodos     Todo[]            @relation("TodoAssignee")
  activityHistories ActivityHistory[] @relation("ActivityEmployee")

  @@map("employees")
  @@schema("CRMSFASystem")
}

// ============================================================
// CustomerCompany（顧客企業）
// DB テーブル名: customers（既存テーブルを維持）
// ============================================================
model CustomerCompany {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  contacts          CustomerContact[]
  deals             Deal[]
  todos             Todo[]            @relation("TodoCustomer")
  activityHistories ActivityHistory[] @relation("ActivityCustomer")

  @@map("customers")
  @@schema("CRMSFASystem")
}

// ============================================================
// CustomerContact（顧客担当者）
// ============================================================
model CustomerContact {
  id         String  @id @default(uuid())
  name       String
  department String?
  position   String?
  phone      String?
  email      String?
  isDeleted  Boolean @default(false) @map("is_deleted")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  customerCompanyId String          @map("customer_company_id")
  customerCompany   CustomerCompany @relation(fields: [customerCompanyId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("customer_contacts")
  @@schema("CRMSFASystem")
}

// ============================================================
// Deal（案件）
// ============================================================
model Deal {
  id                String   @id @default(uuid())
  name              String
  phase             String   @default("MEETING")
  probability       Int?
  expectedQuantity  Decimal? @map("expected_quantity")
  expectedUnitPrice Decimal? @map("expected_unit_price")
  expectedAmount    Decimal? @map("expected_amount")
  industry          String?
  usage             String?
  importance        String?
  stagnationReason  String?  @map("stagnation_reason")
  isDeleted         Boolean  @default(false) @map("is_deleted")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  customerCompanyId String          @map("customer_company_id")
  customerCompany   CustomerCompany @relation(fields: [customerCompanyId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  employeeId String   @map("employee_id")
  employee   Employee @relation("DealEmployee", fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  todos             Todo[]
  activityHistories ActivityHistory[]

  @@map("deals")
  @@schema("CRMSFASystem")
}

// ============================================================
// Todo（TODO / ネクストアクション）
// ============================================================
model Todo {
  id          String    @id @default(uuid())
  title       String
  description String?
  dueDate     DateTime? @map("due_date")
  status      String    @default("NOT_STARTED")
  priority    String    @default("MEDIUM")
  type        String    @default("TODO")
  startDate   DateTime? @map("start_date")
  completedAt DateTime? @map("completed_at")
  completedBy String?   @map("completed_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  dealId            String?          @map("deal_id")
  deal              Deal?            @relation(fields: [dealId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  customerCompanyId String?          @map("customer_company_id")
  customerCompany   CustomerCompany? @relation("TodoCustomer", fields: [customerCompanyId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  assigneeId        String?          @map("assignee_id")
  assignee          Employee?        @relation("TodoAssignee", fields: [assigneeId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("todos")
  @@schema("CRMSFASystem")
}

// ============================================================
// ActivityHistory（活動履歴）
// ============================================================
model ActivityHistory {
  id           String   @id @default(uuid())
  activityDate DateTime @map("activity_date")
  activityType String?  @map("activity_type")
  method       String
  isVisit      Boolean  @default(false) @map("is_visit")
  result       String?
  memo         String?
  duration     Int?
  isDeleted    Boolean  @default(false) @map("is_deleted")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  dealId            String?          @map("deal_id")
  deal              Deal?            @relation(fields: [dealId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  customerCompanyId String?          @map("customer_company_id")
  customerCompany   CustomerCompany? @relation("ActivityCustomer", fields: [customerCompanyId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  employeeId        String           @map("employee_id")
  employee          Employee         @relation("ActivityEmployee", fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("activity_histories")
  @@schema("CRMSFASystem")
}
